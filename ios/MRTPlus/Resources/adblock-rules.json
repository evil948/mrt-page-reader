    },
    "action": { "type": "block" }
  },
  {
    "trigger": { "url-filter": ".*" },
    "action": {
      "type": "css-display-none",
      "selector": "iframe[src*='adfox'],iframe[src*='doubleclick'],iframe[src*='googlesyndication'],iframe[src*='an.yandex'],iframe[src*='yandexadexchange'],iframe[src*='ads.yandex'],iframe[id*='adfox'],iframe[class*='adfox'],[id*='yandex_rtb'],[class*='yandex_rtb']"
